{
  "name": "meta-ai-hackathon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @vitrina/web build",
    "start": "pnpm --filter @vitrina/server start",
    "shop:create": "node apps/server/src/create-shop.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/server/src/**/*.test.ts\"",
    "catalog": "node --env-file-if-exists=.env scripts/catalog.ts",
    "spike:sam": "node --env-file-if-exists=.env scripts/spike-sam.ts",
    "spike:speech": "node --env-file-if-exists=.env scripts/spike-speech.ts",
    "seller:eval": "node --env-file-if-exists=.env scripts/seller-eval.ts"
  },
  "dependencies": {
    "@vitrina/catalog": "workspace:*",
    "@vitrina/meta": "workspace:*",
    "@vitrina/seller": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
