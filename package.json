{
  "name": "meta-ai-hackathon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/src/**/*.test.ts\"",
    "catalog": "node --env-file-if-exists=.env scripts/catalog.ts",
    "spike:sam": "node --env-file-if-exists=.env scripts/spike-sam.ts",
    "spike:speech": "node --env-file-if-exists=.env scripts/spike-speech.ts"
  },
  "dependencies": {
    "@vitrina/catalog": "workspace:*",
    "@vitrina/meta": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
