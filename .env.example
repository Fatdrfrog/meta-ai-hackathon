# Copy to .env (git ignores it). Use your own hackathon keys, never airi.chat's.

# Meta Model API key from https://dev.meta.ai
MODEL_API_KEY=

# Hard cap on estimated Meta spend from this machine, in USD. Calls stop once it's reached.
# Meta's own "Spend Limit" only sends a notification.
META_BUDGET_USD=20

# Optional overrides
# META_API_BASE_URL=https://api.meta.ai/v1
# MUSE_SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1

# Speech to text for spoken prices. Muse Spark misses Kazakh speech and Muse Voice Transcribe
# has no Kazakh or Russian (docs/findings.md), so one of these does the listening. Optional.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Baseten, for Muse Spark Open. The hackathon model ID differs from the one in Baseten's docs.
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
