{
  "name": "icecore-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:widget": "turbo run dev --filter=@icecore/widget",
    "dev:web": "turbo run dev --filter=@icecore/web",
    "dev:mobile": "turbo run dev --filter=@icecore/mobile",
    "dev:temporal-worker": "turbo run dev --filter=@icecore/temporal-worker",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "verify:dependency-direction": "node .github/scripts/verify-dependency-direction.mjs",
    "check-types": "pnpm run verify:dependency-direction && turbo run check-types",
    "check-types:temporal-worker": "turbo run check-types --filter=@icecore/temporal-worker",
    "doctor": "pnpm dlx react-doctor@0.5.0 . --yes --no-score --diff false --project @icecore/web,@icecore/widget",
    "doctor:errors": "pnpm dlx react-doctor@0.5.0 . --yes --no-score --diff false --no-warnings --project @icecore/web,@icecore/widget",
    "doctor:json": "pnpm dlx react-doctor@0.5.0 . --yes --no-score --diff false --json --json-compact --project @icecore/web,@icecore/widget"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.x"
  }
}
