# Local Temporal development
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Temporal Cloud
# TEMPORAL_ADDRESS=ap-northeast-1.aws.api.temporal.io:7233
# TEMPORAL_NAMESPACE=your-namespace.account-id
# TEMPORAL_API_KEY=your_temporal_api_key

# Optional override
TEMPORAL_TASK_QUEUE=airi-conversation
# Run a separate worker pool with TEMPORAL_TASK_QUEUE=airi-media and a low
# TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_EXECUTIONS value for media edits.
AIRI_MEDIA_TASK_QUEUE=airi-media
AIRI_MEDIA_WORKER_ENABLED=true
AIRI_MEDIA_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_EXECUTIONS=1
AIRI_MEDIA_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_POLLS=1
AIRI_MEDIA_WORKER_MAX_CONCURRENT_WORKFLOW_TASK_EXECUTIONS=4
AIRI_MEDIA_WORKER_MAX_CONCURRENT_WORKFLOW_TASK_POLLS=1

# Worker deployment identity / versioning
TEMPORAL_WORKER_DEPLOYMENT_NAME=airi-temporal-worker
# Prefer the image digest or git SHA in production.
TEMPORAL_WORKER_BUILD_ID=dev-build
TEMPORAL_WORKER_VERSIONING_BEHAVIOR=PINNED

# Workflow code loading
# In production, bake a prebuilt bundle and point to it if you don't use the default dist path.
# TEMPORAL_WORKER_WORKFLOW_BUNDLE_PATH=../dist/workflow-bundle.js

# Runtime mode:
# - worker: Temporal worker pool
# - ai-gateway: HTTP gateway for embeddings and search
# - media-api: HTTP API for private creative asset GCS uploads/read URLs
# AIRI_RUNTIME_MODE=worker

# Higgsfield creative asset generation
HIGGSFIELD_API_KEY=your_higgsfield_api_key
HIGGSFIELD_API_SECRET=your_higgsfield_api_secret
# Alternative single credential format, if provided by Higgsfield:
# HIGGSFIELD_KEY=your_higgsfield_key
HIGGSFIELD_WEBHOOK_SECRET=generate_a_long_random_secret
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/soul/standard
HIGGSFIELD_IMAGE_TO_VIDEO_MODEL=higgsfield-ai/dop/standard
# Add provider CDN hosts here if Higgsfield / Alibaba return signed media URLs
# outside the default allowlist (higgsfield.ai + *.aliyuncs.com OSS).
HIGGSFIELD_MEDIA_HOST_ALLOWLIST=higgsfield.ai,*.higgsfield.ai,*.aliyuncs.com
HIGGSFIELD_MEDIA_DOWNLOAD_TIMEOUT_MS=60000

# Platform text AI (replies, classification, extraction, summaries, scenario
# generation) runs on Claude through the Anthropic API. Required for platform
# text AI; without it, text generation falls back to Vertex Gemini.
# Workspace-provided Google AI keys (customer billing) keep using Gemini.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Only for a key not scoped to one workspace (the API then answers 400 "must
# include the anthropic-workspace-id header"): the workspace id to bill.
# ANTHROPIC_WORKSPACE_ID=
# Optional model overrides (defaults shown; use exact ids without date suffixes):
# light = classification/extraction/short translations, heavy = replies/summaries/
# rerank/drafts/prompt optimizer, reasoning = scenario generator.
# ANTHROPIC_LIGHT_MODEL=claude-haiku-4-5
# ANTHROPIC_HEAVY_MODEL=claude-sonnet-5-5
# ANTHROPIC_REASONING_MODEL=claude-opus-5-5
# ANTHROPIC_AI_ENABLED=true
# Platform text provider order; providers that are not configured are skipped.
# AI_CHAT_PROVIDER_ORDER=anthropic,vertex
# Gemini/Vertex credentials (or Google ADC) are still needed for embeddings,
# the Vertex ranking API, media analysis, image/video generation and the
# Vertex Gemini outage fallback for text.

# Google Veo video generation (the worker submits and finalizes these jobs).
# GEMINI_API_KEY is canonical; GOOGLE_API_KEY remains a supported fallback.
GEMINI_API_KEY=your_google_generative_language_api_key
# GOOGLE_API_KEY=your_google_generative_language_api_key
# GOOGLE_VIDEO_GENERATION_MODEL=veo-3.1-generate-preview
# Extra signed-media hosts, comma-separated, when Google returns a host outside
# the built-in Google storage allowlist.
# GOOGLE_GENERATIVE_MEDIA_HOST_ALLOWLIST=storage.googleapis.com

# Alibaba Model Studio (Singapore) — Qwen image + Wan avatars + HappyHorse video
# Host example: https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
ALIBABA_API_KEY=your_alibaba_model_studio_api_key
ALIBABA_API_HOST=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com
# QWEN_IMAGE_MODEL=qwen-image-2.0-pro
# WAN_S2V_MODEL=wan2.7-i2v-2026-04-25
# WAN_I2V_MODEL=wan2.7-i2v-2026-04-25
# WAN_S2V_DEFAULT_RESOLUTION=1080P
# HAPPYHORSE_T2V_MODEL=happyhorse-1.1-t2v
# HAPPYHORSE_I2V_MODEL=happyhorse-1.1-i2v
# HAPPYHORSE_R2V_MODEL=happyhorse-1.1-r2v
# HAPPYHORSE_DEFAULT_RESOLUTION=1080P
# HAPPYHORSE_DEFAULT_RATIO=9:16

NEXT_PUBLIC_APP_URL=http://localhost:3000
GCS_CREATIVE_ASSETS_BUCKET=icecore-ai-creative-assets-prod
# Optional override for bulk campaign payload staging (defaults to GCS_CREATIVE_ASSETS_BUCKET)
# GCS_BULK_DISPATCH_BUCKET=icecore-ai-creative-assets-prod
# WhatsApp LLM feedback buttons (helpful / not helpful) after Airi replies.
# Must be set on the Temporal worker — delivery runs there, not on Vercel.
# LLM_WHATSAPP_FEEDBACK_PROMPT_ENABLED=true
# LLM_WHATSAPP_FEEDBACK_TESTERS=77473035733,770512345678
BRIA_API_TOKEN=your_bria_api_token

# Creative asset video edits use Bria's async green-screen API. The local
# MediaPipe runner remains in-tree as a fallback/reference implementation.

# ElevenLabs async speech-to-text submission. Configure the provider endpoint
# as <airi-media-api-url>/webhooks/elevenlabs/speech-to-text. The media API
# verifies the HMAC signature and signals the owning Temporal workflow.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_STT_ENABLED=false
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_WEBHOOK_ID=your_elevenlabs_stt_webhook_id
ELEVENLABS_STT_WEBHOOK_SECRET=your_elevenlabs_stt_webhook_secret
ELEVENLABS_TIMEOUT_MS=45000

# Conversation classification events use one shared topic for web and worker
# publishers. The consumer stays disabled until reconciliation gates pass.
CONVERSATION_CLASSIFICATION_PUBSUB_ENABLED=false
# CONVERSATION_CLASSIFICATION_PUBSUB_PROJECT_ID=your_gcp_project_id
CONVERSATION_CLASSIFICATION_PUBSUB_TOPIC=icecore-conversation-classification-events
CONVERSATION_CLASSIFICATION_PUBSUB_SUBSCRIPTION=icecore-conversation-classification-events-worker
# CONVERSATION_CLASSIFICATION_PUBSUB_MAX_MESSAGES=50

# WhatsApp call media through the LiveKit Connector API. Full Cloud Embedded
# Signup sources prepare media by default once Meta phone calling is enabled;
# coexistence sources do not auto-prepare media.
# WHATSAPP_CALL_PUBSUB_ENABLED=true
# WHATSAPP_CALL_PUBSUB_PROJECT_ID=your_gcp_project_id
# WHATSAPP_CALL_PUBSUB_TOPIC=icecore-whatsapp-call-events
# WHATSAPP_CALL_PUBSUB_SUBSCRIPTION=icecore-whatsapp-call-events-worker
# WHATSAPP_CALL_PUBSUB_MAX_MESSAGES=50
# WHATSAPP_CALL_COMMAND_TIMEOUT_SECONDS=30
# WHATSAPP_CALL_RECORDING_BUCKET=icecore-ai-whatsapp-call-recordings
# WHATSAPP_CALL_RECORDING_EGRESS_ENABLED=false
# WHATSAPP_CALL_RECORDING_FILE_TYPE=OGG
# WHATSAPP_CALL_RECORDING_RETENTION_DAYS=90
# WHATSAPP_CALL_RECORDING_PIPELINE_ENABLED=false
# WHATSAPP_CALL_RECORDING_PIPELINE_URL=https://your-recording-transcription-worker/recordings/whatsapp/finalize
# WHATSAPP_CALL_RECORDING_WEBHOOK_URL=https://www.airi.chat/api/webhooks/whatsapp/call-recording
# WHATSAPP_CALL_TRANSCRIPTION_ENABLED=false
# WHATSAPP_CALL_TRANSCRIPTION_PROJECT_ID=your_gcp_project_id
# WHATSAPP_CALL_TRANSCRIPTION_LOCATION=global
# WHATSAPP_CALL_TRANSCRIPTION_LANGUAGE_CODES=kk-KZ,en-US
# WHATSAPP_CALL_TRANSCRIPTION_LANGUAGE_CODE=und
# WHATSAPP_CALL_TRANSCRIPTION_MODEL=long
# WHATSAPP_CALL_TRANSCRIPTION_RECOGNIZER=_
# WHATSAPP_CALL_TRANSCRIPTION_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_gcp_project"}
# WHATSAPP_CALL_TRANSCRIPTION_DRAIN_SCHEDULE_ENABLED=true
# WHATSAPP_CALL_TRANSCRIPTION_DRAIN_LIMIT=50
# WHATSAPP_CALL_ANALYTICS_ENABLED=false
# WHATSAPP_CALL_ANALYTICS_PROJECT_ID=your_gcp_project_id
# WHATSAPP_CALL_ANALYTICS_TOPIC=icecore-whatsapp-call-analytics
# LiveKit Cloud is the media transport for WhatsApp calls. ElevenLabs remains
# the voice-bot/TTS vendor; do not add a second voice-bot provider here.
# LIVEKIT_URL=wss://your-livekit-cloud-project.livekit.cloud
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_EGRESS_GCP_CREDENTIALS_JSON={"type":"service_account","project_id":"your_gcp_project"}
# LIVEKIT_EGRESS_TOKEN_TTL_SECONDS=600
# LIVEKIT_WHATSAPP_CLOUD_API_VERSION=24.0
# LIVEKIT_MEDIA_TOKEN_TTL_SECONDS=300

# Halyk ePay recurring billing
HALYK_EPAY_ENV=test
HALYK_EPAY_CLIENT_ID=your_halyk_client_id
HALYK_EPAY_CLIENT_SECRET=your_halyk_client_secret
HALYK_EPAY_TERMINAL_ID=your_halyk_terminal_id

# Local-only AI gateway auth bypass. Required when apps/web points
# GCP_AI_GATEWAY_URL at http://127.0.0.1:8080. Leave unset in production.
# AI_GATEWAY_DISABLE_AUTH=true

# Production AI gateway auth settings (Vercel OIDC -> Cloud Run service only)
# Team issuer mode:
# AI_GATEWAY_VERCEL_OIDC_ISSUER_URL=https://oidc.vercel.com/your-team-slug
# Global issuer mode:
# AI_GATEWAY_VERCEL_OIDC_ISSUER_URL=https://oidc.vercel.com
# AI_GATEWAY_VERCEL_OIDC_AUDIENCE=https://vercel.com/your-team-slug
# AI_GATEWAY_VERCEL_OIDC_SUBJECTS=owner:your-team-slug:project:your-project-name:environment:production,owner:your-team-slug:project:your-project-name:environment:preview

# Explicit worker tuning for production
TEMPORAL_WORKER_REUSE_V8_CONTEXT=true
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASK_EXECUTIONS=32
TEMPORAL_WORKER_MAX_CONCURRENT_WORKFLOW_TASK_POLLS=8
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_EXECUTIONS=8
TEMPORAL_WORKER_MAX_CONCURRENT_ACTIVITY_TASK_POLLS=4
TEMPORAL_WORKER_MAX_CACHED_WORKFLOWS=128
TEMPORAL_WORKER_SHUTDOWN_GRACE_TIME=30s
TEMPORAL_WORKER_SHUTDOWN_FORCE_TIME=120s
