  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../../.github/scripts/verify-supabase-campaign-contract.mjs --production-only",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix --cache --cache-location .eslintcache",
    "check-types": "tsc --noEmit --project tsconfig.build.json",
    "type-check": "pnpm run check-types",
    "typegen": "next typegen",
    "backfill:conversation-first-response": "tsx scripts/backfill-conversation-first-response.ts",
    "backfill:customer-display-names": "tsx --conditions=react-server scripts/backfill-customer-display-names.ts",
    "backfill:telegram-bot-token-encryption": "tsx --conditions=react-server scripts/backfill-telegram-bot-token-encryption.ts",
    "backfill:instagram-messages": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/backfill-instagram-messages.ts",
    "backfill:whatsapp-campaign-costs": "tsx --conditions=react-server scripts/backfill-whatsapp-campaign-costs.ts",
    "ensure:mongo-indexes": "tsx scripts/ensure-mongo-indexes.ts",
    "eval:airi-intents": "tsx --conditions=react-server scripts/airi-eval.ts",
    "operator:activation-funnel": "tsx scripts/report-activation-funnel.ts",
    "operator:business-media-move": "tsx scripts/business-media-move-operator.ts",
    "operator:mongo-index-costs": "tsx scripts/mongo-index-cost-operator.ts",
    "operator:mongo-retention": "tsx scripts/mongo-retention-operator.ts",
    "operator:whatsapp-template-insights": "tsx --conditions=react-server scripts/enable-whatsapp-template-insights.ts",
    "migrate:interactive-no-reply": "tsx --conditions=react-server scripts/migrate-interactive-no-reply-assignments.ts",
    "migrate:legacy-scenario-redraw": "tsx --conditions=react-server scripts/migrate-legacy-scenario-redraw.ts",
    "migrate:whatsapp-qr-entry-point-indexes": "tsx scripts/migrate-whatsapp-qr-entry-point-indexes.ts",
    "operator:request-list-projection": "tsx --conditions=react-server scripts/request-list-projection-operator.ts",
    "analytics:project": "tsx --conditions=react-server scripts/project-analytics.ts",
    "migrate:whatsapp-qr-manager": "tsx --conditions=react-server scripts/migrate-whatsapp-qr-manager.ts",
    "verify:whatsapp-qr-manager-query-plans": "tsx scripts/verify-whatsapp-qr-manager-query-plans.ts",
    "repair:scenario-post-action-timers": "tsx --conditions=react-server scripts/repair-scenario-post-action-timers.ts",
    "repair:whatsapp-reply-meta": "tsx scripts/repair-whatsapp-reply-meta.ts",
    "test": "jest",
    "test:landing": "jest src/components/landing src/i18n/landing-translations.test.ts src/components/ui/chart.test.tsx src/app/banner.test.tsx src/lib/tracking-consent.test.ts src/lib/public-seo.test.ts src/lib/landing src/app/api/landing/demo-request src/app/api/landing/template-request src/app/whatsapp-templates src/app/sitemap.test.ts src/features/panel/root/loading-view.test.tsx src/features/panel/root/layout-route.test.tsx src/components/whatsapp/carousel-cards-scroller.test.tsx src/components/dashboard/conversation-volume-chart.test.tsx src/components/dashboard/category-distribution-chart.test.tsx src/components/dashboard/performance-components-localization.test.tsx --runInBand --roots src --watchman=false",
    "test:scenarios": "jest --runInBand --testPathPatterns=\"src.*scenarios?\"",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rag-golden": "jest src/lib/airi/rag/eval/rag-golden.eval.test.ts src/lib/airi/rag/eval/rag-golden-planner-llm.eval.test.ts --no-cache",
    "test:rag-ragas": "jest src/lib/airi/rag/eval/rag-ragas.eval.test.ts --no-cache",
    "test:rag-reliability": "jest src/lib/airi/rag/eval/rag-reliability-stress.eval.test.ts --no-cache",
    "test:rag-launch-gate": "jest src/lib/airi/rag/eval/rag-launch-gate.eval.test.ts --no-cache",
    "test:e2e": "pnpm run test:e2e:whatsapp-qr && pnpm run test:e2e:telegram",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:telegram": "playwright test --config playwright.telegram.config.ts",
    "test:e2e:whatsapp-qr": "playwright test e2e/scenarios/whatsapp-qr-entry-point.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
