{
	"name": "@icecore/widget",
	"version": "0.1.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm run build:widget && pnpm run build:loader && pnpm run build:commerce-adapters",
		"build:widget": "cross-env VITE_ENTRY=widget vite build --emptyOutDir",
		"build:loader": "cross-env VITE_ENTRY=loader vite build --no-emptyOutDir",
		"build:commerce-adapters": "cross-env VITE_ENTRY=commerce-adapters vite build --no-emptyOutDir",
		"test": "node --test tests/*.test.mjs",
		"preview": "vite preview",
		"preview:demo": "vite preview --open demo.html"
	},
	"dependencies": {
		"@icecore/shared": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.511.0",
		"preact": "^10.29.8",
		"radix-ui": "^1.4.3",
		"tailwind-merge": "^2.2.0",
		"use-stick-to-bottom": "^1.1.3"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.2",
		"@tailwindcss/vite": "^4.2.0",
		"cross-env": "^7.0.3",
		"eslint": "^9.36.0",
		"eslint-config-preact": "^2.0.0",
		"tailwindcss": "^4",
		"terser": "^5.36.0",
		"typescript": "^5.9.2",
		"vite": "^8.3.0"
	}
}
